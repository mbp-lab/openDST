PUBLIC_URL=/study_assets/digital-stress-test-published
REACT_APP_MOBILE_ONLY = 'true'
REACT_APP_VIDEO_RECORDING = 'false'
REACT_APP_LOGGING = 'false'
REACT_APP_SURVEY_HOST_PATH = 'https://www.soscisurvey.de/resilience2021/'
REACT_APP_DEBRIEFING_HOST_PATH = 'https://resilience.tf.uni-bielefeld.de/debriefing/'
REACT_APP_ADDITIONAL_INFORMATION_URL_DE = 'some_url'
REACT_APP_ADDITIONAL_INFORMATION_URL_EN = 'some_url'

# Optional browser-facecrop recording (requires video recording and logging).
REACT_APP_FACECROP_RECORDING=false
REACT_APP_FACECROP_ROI_SMOOTHING_TAU_MS=100
REACT_APP_FACECROP_ROI_SCALE=1.4
REACT_APP_FACECROP_ROI_VERTICAL_SHIFT_RATIO=0.15
REACT_APP_FACECROP_DETECTOR_MIN_CONFIDENCE=0.5
REACT_APP_FACECROP_PIPELINE_ANALYSIS_WORKER_COUNT=2
REACT_APP_FACECROP_PERSISTENCE_MAX_ATTEMPTS=3
REACT_APP_FACECROP_PERSISTENCE_RETRY_DELAY_MS=100
REACT_APP_FACECROP_OUTPUT_RESOLUTION=72
REACT_APP_FACECROP_OUTPUT_MAX_PART_MIB=4
REACT_APP_FACECROP_UPLOAD_DIAGNOSTICS=false
